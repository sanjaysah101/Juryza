{
  "name": "juryza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --bun next dev --port 3000",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start --port 8080",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write",
    "lint:unsafe": "biome check . --write --unsafe",
    "format": "biome format --write .",
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "bun run src/lib/db/seed.ts",
    "boot": "bun run db:push && bun run seed && bun run start"
  },
  "dependencies": {
    "@juryza/api-client": "workspace:*",
    "@juryza/auth-better-auth": "workspace:*",
    "@juryza/auth-ui": "workspace:*",
    "@juryza/form-builder": "workspace:*",
    "@juryza/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@juryza/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
