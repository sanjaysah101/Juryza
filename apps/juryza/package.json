{
  "name": "juryza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --bun next dev --port 3000",
    "build": "bun run --bun next build --webpack",
    "start": "bun run --bun next start --port 8080",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test src/lib/__tests__",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write",
    "lint:unsafe": "biome check . --write --unsafe",
    "format": "biome format --write .",
    "db:push": "drizzle-kit push --config ../../packages/database/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ../../packages/database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ../../packages/database/drizzle.config.ts",
    "db:migrate": "bun run ../../packages/database/src/migrate.ts",
    "seed": "bun run src/lib/db/seed.ts",
    "boot": "bun run db:migrate && bun run seed && bun run start"
  },
  "dependencies": {
    "@juryza/database": "workspace:*",
    "@juryza/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@juryza/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
