# Every variable Juryza reads. docker-compose sets these for you; copy to
# .env.local for `bun run dev`.

# Postgres connection.
DATABASE_URL=postgres://juryza:juryza@localhost:5432/juryza

# Signs sessions (and certificates, unless SIGNING_SECRET is set). A dev-only
# fallback exists so `bun run dev` works immediately — set a real one in
# production:  openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
# Optional: separate key for certificate signatures.
# SIGNING_SECRET=

# The public origin the portal is served from (auth callbacks, reset links).
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call the auth endpoints, comma-separated.
# TRUSTED_ORIGINS=https://hack.example.org

# Seed options (container start):
# PORTAL_BASE_URL=http://localhost:8080   base_url written to .dogfood.toml
# FIXTURES_PATH=/repo/fixtures.json
# DOGFOOD_TOML_PATH=/repo/.dogfood.toml
# SEED_RESET=1                            wipe and reseed
