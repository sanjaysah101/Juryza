# Postgres connection. docker-compose overrides this to point at the `db` service.
DATABASE_URL=postgres://juryza:juryza@localhost:5432/juryza

# Better Auth signing secret. Generate with: openssl rand -base64 32
# A dev-only fallback exists in source so `bun run dev` works immediately.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me

# Base URL the portal is served from.
BETTER_AUTH_URL=http://localhost:8080
