{
  "name": "juryza",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter='./apps/*'",
    "dev:cli": "turbo run dev --filter=juryza",
    "lint": "turbo run lint",
    "lint:fix": "biome check . --write",
    "lint:unsafe": "biome check . --write --unsafe",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "husky",
    "notils": "notils"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@juryza/config": "workspace:*",
    "husky": "^9.1.7",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3",
    "@notils/cli": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "0.1.0",
  "description": "",
  "keywords": [],
  "packageManager": "bun@1.3.14"
}
